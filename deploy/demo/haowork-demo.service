[Unit]
Description=Haowork public read-only demonstration
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=HAOWORK_DEMO_ADDR=127.0.0.1:4175
ExecStart=/home/codechase/haowork-demo/haowork-demo
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/codechase/haowork-demo

[Install]
WantedBy=default.target
