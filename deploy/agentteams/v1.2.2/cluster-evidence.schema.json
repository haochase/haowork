{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://haowork.local/schemas/p0-05-v1.2.2-cluster-evidence.schema.json",
  "title": "Haowork P0-05 AgentTeams v1.2.2 Cluster Evidence",
  "type": "object",
  "required": [
    "schema_version",
    "baseline",
    "topology",
    "skills",
    "data_path",
    "network_policy",
    "restart"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "baseline": {
      "type": "object",
      "required": ["cluster_name", "contract", "crd_kinds", "zones"],
      "properties": {
        "cluster_name": { "type": "string", "minLength": 1, "maxLength": 63, "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$" },
        "contract": {
          "type": "object",
          "required": ["tag", "commit", "chart_version"],
          "properties": {
            "tag": { "const": "v1.2.2" },
            "commit": { "const": "849182af8e017168a5a200a87b1062142caf462d" },
            "chart_version": { "const": "1.1.1" }
          },
          "additionalProperties": false
        },
        "crd_kinds": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "type": "string", "enum": ["Human", "Manager", "Team", "Worker"] }
        },
        "zones": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "required": ["name", "namespace", "release"],
            "properties": {
              "name": { "type": "string", "enum": ["public", "internal"] },
              "namespace": { "type": "string", "enum": ["haowork-public", "haowork-internal"] },
              "release": { "type": "string", "enum": ["haowork-public-agentteams", "haowork-internal-agentteams"] }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "topology": {
      "type": "object",
      "required": ["team_name", "room_kind", "agent_roles", "zone"],
      "properties": {
        "team_name": { "type": "string", "minLength": 1, "maxLength": 63, "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$" },
        "room_kind": { "const": "leader_dm" },
        "agent_roles": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": { "type": "string", "enum": ["manager", "delivery_leader", "research", "build", "verify"] }
        },
        "zone": { "type": "string", "enum": ["public", "internal"] }
      },
      "additionalProperties": false
    },
    "skills": {
      "type": "object",
      "required": ["research", "build", "verify"],
      "properties": {
        "research": { "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": { "type": "string", "enum": ["context", "history", "advisory", "mirror"] } },
        "build": { "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": { "type": "string", "enum": ["context", "record", "history", "patch"] } },
        "verify": { "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": { "type": "string", "enum": ["history", "verify", "audit"] } }
      },
      "additionalProperties": false
    },
    "data_path": {
      "type": "object",
      "required": ["assignment", "matrix", "receipt", "artifact", "mcp"],
      "properties": {
        "assignment": {
          "type": "object",
          "required": ["assignment_id", "state"],
          "properties": {
            "assignment_id": { "type": "string", "minLength": 36, "maxLength": 36, "pattern": "^ASN-[0-9a-f]{32}$" },
            "state": { "const": "REPORT_SUBMITTED" }
          },
          "additionalProperties": false
        },
        "matrix": {
          "type": "object",
          "required": ["dispatch_event_id", "room_kind"],
          "properties": {
            "dispatch_event_id": { "type": "string", "minLength": 2, "maxLength": 255, "pattern": "^\\$\\S+$", "format": "matrix-event-id" },
            "room_kind": { "const": "leader_dm" }
          },
          "additionalProperties": false
        },
        "receipt": {
          "type": "object",
          "required": ["receipt_id", "report_sha256", "leader_function", "binding_revision"],
          "properties": {
            "receipt_id": { "type": "string", "minLength": 5, "maxLength": 128, "pattern": "^ERC-[A-Za-z0-9][A-Za-z0-9._:-]{0,123}$" },
            "report_sha256": { "type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$" },
            "leader_function": { "const": "delivery_leader" },
            "binding_revision": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        },
        "artifact": {
          "type": "object",
          "required": ["uri", "sha256", "size", "environment_id"],
          "properties": {
            "uri": { "type": "string", "minLength": 8, "maxLength": 2048, "pattern": "^s3://(?![a-z0-9.-]*\\.\\.)[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]/(?!\\.{1,2}(?:/|$))(?!.*?/\\.{1,2}(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$", "format": "uri" },
            "sha256": { "type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$" },
            "size": { "type": "integer", "minimum": 0 },
            "environment_id": { "type": "string", "minLength": 1, "maxLength": 63, "pattern": "^[a-z][a-z0-9-]{0,62}$" }
          },
          "additionalProperties": false
        },
        "mcp": {
          "type": "object",
          "required": ["server_name", "consumer_kind", "trace_sha256"],
          "properties": {
            "server_name": { "type": "string", "minLength": 1, "maxLength": 63, "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$" },
            "consumer_kind": { "const": "agentteams_worker" },
            "trace_sha256": { "type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "network_policy": {
      "type": "object",
      "required": ["public_to_internal", "internal_to_public"],
      "properties": {
        "public_to_internal": { "const": "denied" },
        "internal_to_public": { "const": "denied" }
      },
      "additionalProperties": false
    },
    "restart": {
      "type": "object",
      "required": ["controller", "start_new_state", "receipt_id"],
      "properties": {
        "controller": { "const": "core_bridge" },
        "start_new_state": { "const": "FRESH_RUN" },
        "receipt_id": { "type": "string", "minLength": 5, "maxLength": 128, "pattern": "^ERC-[A-Za-z0-9][A-Za-z0-9._:-]{0,123}$" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
