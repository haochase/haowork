# Copy this file to .env.local. Never commit .env.local or a real API key.

HAOWORK_P005_PUBLIC_LLM_PROVIDER=openai-compat
HAOWORK_P005_PUBLIC_LLM_BASE_URL=https://public-provider.example/v1
HAOWORK_P005_PUBLIC_LLM_API_KEY=replace-with-public-key
HAOWORK_P005_PUBLIC_LLM_MODEL=replace-with-public-model-id
